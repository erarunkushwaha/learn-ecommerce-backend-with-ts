{
  "name": "ecom-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Interview-lab e-commerce API. HTTP app, /api/v1, and liveness health are in place.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
