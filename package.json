{
  "name": "ecom-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Interview-lab e-commerce API. HTTP app, /api/v1, liveness health, and Zod environment config are in place. Local MySQL and Redis run in Docker Compose.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node --env-file=.env dist/server.js",
    "start": "node --env-file=.env dist/server.js",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "infra:check": "tsc -p tsconfig.json && node --env-file=.env scripts/check-data-stores.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  }
}
