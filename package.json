{
  "name": "ecom-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Interview-lab e-commerce API. HTTP app, /api/v1, liveness and MySQL readiness, Zod environment config, JSON error handling, structured request logs, one Sequelize pool, a startup MySQL probe, SIGINT/SIGTERM drain, and a migration command for Compose MySQL are in place. ESLint and Prettier check the code. Local MySQL and Redis run in Docker Compose. labs/f10-types and labs/f11-types are TypeScript exercises outside the HTTP process.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lab:f10": "tsc -p labs/f10-types/tsconfig.json && node labs/f10-types/dist/run.js",
    "lab:f11": "tsc -p labs/f11-types/tsconfig.json && node labs/f11-types/dist/run.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src\" \"tests\" \"scripts\" \"labs\" \"eslint.config.js\" \"package.json\"",
    "format:check": "prettier --check \"src\" \"tests\" \"scripts\" \"labs\" \"eslint.config.js\" \"package.json\"",
    "dev": "tsc -p tsconfig.json && node --env-file=.env dist/server.js",
    "start": "node --env-file=.env dist/server.js",
    "test": "tsc -p tsconfig.json && node --test --test-reporter=spec \"tests/**/*.test.mjs\"",
    "infra:check": "tsc -p tsconfig.json && node --env-file=.env scripts/check-data-stores.mjs",
    "db:migrate": "tsc -p tsconfig.json && node --env-file=.env dist/database/cli.js migrate",
    "db:migrate:undo": "tsc -p tsconfig.json && node --env-file=.env dist/database/cli.js migrate:undo",
    "db:seed": "tsc -p tsconfig.json && node --env-file=.env dist/database/cli.js seed",
    "db:seed:undo": "tsc -p tsconfig.json && node --env-file=.env dist/database/cli.js seed:undo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  }
}
