# Local Docker Compose only. Copy this file to .env.
# These values are for the Compose services on this machine. They are not production secrets.
# Homebrew MySQL on port 3306 is a different server. Do not point these variables at it.
# The HTTP process also reads PORT (unset means 3000) and LOG_LEVEL
# (unset means info: debug, info, warn, or error). It validates every variable
# below except MYSQL_ROOT_PASSWORD, which is only for the MySQL container.
# Validation does not open a connection. npm run infra:check does.

LOG_LEVEL=info
MYSQL_ROOT_PASSWORD=ecom_local_root_password
MYSQL_DATABASE=ecom
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom_local_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=ecom_local_redis_password
